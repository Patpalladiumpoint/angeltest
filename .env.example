# App database. The app connects with a role (palladium_app) that has no
# UPDATE/DELETE on audit_log/event, and no direct SELECT on
# person_employment.comp / client_contract.fee_percent / job.fee_override
# (see src/db/migrations/0007_permissions_and_dnc.sql).
DATABASE_URL=postgres://palladium_app:palladium_app@localhost:5432/palladium_dev

# Migration role: owns the schema, allowed to run DDL and the
# audit_log/event lockdown + permission-revoke migrations.
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/palladium_dev

# Supabase Auth, Google SSO only (spec section 2). Leave unset to fall back
# to dev sign-in (NODE_ENV !== "production" only) -- see src/auth/session.ts.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for documents (resumes, contracts, etc.). Private,
# signed URLs only -- see src/storage/documents.ts.
DOCUMENTS_BUCKET=documents

# Backups: S3-compatible endpoint that must live in a different
# account/region than the primary DB and the documents bucket (section 6).
BACKUPS_BUCKET=palladium-backups
BACKUPS_S3_ENDPOINT=
BACKUPS_S3_REGION=us-west-2
BACKUPS_S3_ACCESS_KEY_ID=
BACKUPS_S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Restore drill scratch database. Never point this at dev or prod.
RESTORE_DRILL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/palladium_restore_drill

# Dev/CI seed (src/db/seed.ts). Comma-separated for ops/recruiter.
SEED_ORGANIZATION_NAME=Palladium Point
SEED_EXEC_EMAIL=
SEED_OPS_EMAILS=
SEED_RECRUITER_EMAILS=

# Demo client portal contact (src/portal/seedContacts.ts).
SEED_CLIENT_CONTACT_EMAIL=
SEED_CLIENT_CONTACT_NAME=
SEED_CLIENT_CONTACT_BROKERAGE=

# Client portal magic-link email delivery (src/portal/emailSender.ts).
# Not wired yet -- no provider account exists in this sandbox. Until
# RESEND_API_KEY (or an equivalent for whatever provider is chosen) is
# set AND emailSender.ts's ConsoleEmailSender is replaced with a real
# implementation, magic links are only ever logged server-side (and, in
# non-production, shown directly on the sign-in page). See
# docs/manual-steps.md #5 for the exact steps.
RESEND_API_KEY=
