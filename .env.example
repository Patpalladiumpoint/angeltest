# App database. The app connects with the palladium_app role, which has no
# UPDATE/DELETE on audit_log or event (see migrations).
DATABASE_URL=postgres://palladium_app:palladium_app@localhost:5432/palladium_dev

# Migration role: owns the schema, allowed to run DDL and the append-only
# lockdown migrations.
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/palladium_dev

# Supabase (spec section 2: Postgres + pgvector + RLS, and Supabase Auth for
# Google SSO). For local dev, run the Supabase CLI's local stack
# (`supabase start`) -- it prints these values, plus a local Postgres URL
# you can point DATABASE_URL / MIGRATIONS_DATABASE_URL at instead of a bare
# local Postgres.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google SSO only (OQ 7 default). Restricts sign-in to this Workspace
# domain at the IdP level (see src/app/sign-in/page.tsx). Configure the
# Google provider inside the Supabase Auth dashboard/CLI config, not here --
# this app only reads the domain to pass as the `hd` param.
NEXT_PUBLIC_GOOGLE_WORKSPACE_DOMAIN=

# Crelate -- BLOCKING, unconfirmed (spec Open Question #1). Setting these
# does not unblock src/adapters/crelate/index.ts by itself: the API
# contract (plan-tier access, webhook vs. polling, rate limits) still needs
# confirming before pull()/push()/reconcile() can be written for real. See
# that file's header comment.
CRELATE_API_KEY=
CRELATE_API_BASE=

# QuickBooks Online (well-documented API; OAuth2, sandbox first per spec
# section 5). Get these by creating a connected app at
# https://developer.intuit.com and completing the OAuth2 authorization-code
# flow once to obtain a refresh token and realm (company) id.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=
QUICKBOOKS_ENVIRONMENT=sandbox

# Inngest (durable workflows backbone, spec section 2). Local dev runs
# without these via `npx inngest-cli dev`; production needs a signing key
# from the Inngest dashboard.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Anthropic API (spec section 6, AI capabilities -- not used by Phase 0,
# reserved for Phase 3).
ANTHROPIC_API_KEY=

# Sentry (spec section 2 observability).
SENTRY_DSN=
