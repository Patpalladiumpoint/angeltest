# App database. The app connects with a role that has no UPDATE/DELETE on audit_log.
DATABASE_URL=postgres://palladium_app:palladium_app@localhost:5432/palladium_dev

# Migration role: owns the schema, allowed to run DDL and the audit_log lockdown migration.
MIGRATIONS_DATABASE_URL=postgres://postgres:postgres@localhost:5432/palladium_dev

# SSO (OIDC). Configure exactly one provider per OQ 7 — Google Workspace assumed by default.
AUTH_PROVIDER=google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# S3-compatible object storage for documents and backups.
DOCUMENTS_BUCKET=palladium-documents
BACKUPS_BUCKET=palladium-backups
S3_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true

# Backups must land in a different account/region than the primary DB and app bucket (3.7).
BACKUPS_S3_ENDPOINT=
BACKUPS_S3_REGION=us-west-2
BACKUPS_S3_ACCESS_KEY_ID=
BACKUPS_S3_SECRET_ACCESS_KEY=

# Restore drill scratch database. Never point this at dev or prod.
RESTORE_DRILL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/palladium_restore_drill
